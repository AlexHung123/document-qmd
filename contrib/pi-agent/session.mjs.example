/**
 * Per-session Dochub MCP for a hosted pi-agent-core agent.
 *
 * The host sets userId / folder from its own auth session.
 * Never let the model choose DOCHUB_USER_ID.
 *
 *   npm install @mariozechner/pi-agent-core @modelcontextprotocol/sdk
 */

import { readFileSync } from "node:fs";
import { Agent } from "@mariozechner/pi-agent-core";
import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StdioClientTransport } from "@modelcontextprotocol/sdk/client/stdio.js";

const SKILL_PATH = new URL("./skills/dochub/SKILL.md", import.meta.url);

export async function createDochubAgent({
  userId,
  folder,
  dochubUrl = process.env.DOCHUB_URL || "http://127.0.0.1:8787",
  pythonPath = process.env.DOCHUB_PYTHONPATH || "/absolute/path/to/documents/src",
  model,
}) {
  if (!userId) {
    throw new Error("userId is required");
  }

  const env = {
    ...process.env,
    PYTHONPATH: pythonPath,
    PYTHONUNBUFFERED: "1",
    DOCHUB_URL: dochubUrl,
    DOCHUB_USER_ID: String(userId),
  };
  if (folder) {
    env.DOCHUB_FOLDER = String(folder);
  } else {
    delete env.DOCHUB_FOLDER;
  }

  const transport = new StdioClientTransport({
    command: "python3",
    args: ["-m", "dochub", "mcp"],
    env,
  });
  const mcp = new Client({ name: "dochub-host", version: "1.0.0" });
  await mcp.connect(transport);

  const listed = await mcp.listTools();
  const tools = listed.tools.map((tool) => ({
    name: `mcp_dochub_${tool.name}`.replace(/[^A-Za-z0-9_-]/g, "_").slice(0, 64),
    label: tool.title ?? tool.name,
    description: tool.description ?? tool.name,
    parameters: {
      ...tool.inputSchema,
      type: "object",
      properties: tool.inputSchema.properties ?? {},
    },
    execute: async (_toolCallId, params, signal) => {
      const result = await mcp.callTool({ name: tool.name, arguments: params, signal });
      const text = (result.content ?? [])
        .filter((block) => block.type === "text")
        .map((block) => block.text)
        .join("\n");
      return {
        content: [{ type: "text", text: text || JSON.stringify(result.structuredContent ?? result) }],
        details: result,
      };
    },
  }));

  const skill = readFileSync(SKILL_PATH, "utf8");
  const agent = new Agent({
    initialState: {
      systemPrompt: `${skill}\n\nYou are answering from this user's documents via Dochub MCP.`,
      model,
      tools,
    },
  });

  return {
    agent,
    async close() {
      await mcp.close();
    },
  };
}
